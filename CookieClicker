using System.Windows.Navigation;
using System.Windows.Shapes;

namespace WpfApp2
{
    /// <summary>
    /// Interaction logic for MainWindow.xaml
    /// </summary>
    public partial class MainWindow : Window
    {
        private long pocetSuienok = 0; 
        private int silaKliknutia = 1;
        
        public MainWindow()
        {
            InitializeComponent();
        }

        private void Cookie_Click(object sender, RoutedEventArgs e)
        {
            pocetSuienok+=silaKliknutia;
            Label_CookieCounter.Content = pocetSuienok.ToString();
        }

        private void Button_SilnejsiClick_Click(object sender, RoutedEventArgs e)
        {

            

            if(pocetSuienok>=10)
            {
                pocetSuienok -= 10;
                silaKliknutia += 2;
            }
            

        }

        private void Button_SuperClick_Click(object sender, RoutedEventArgs e)
        {

            if (pocetSuienok >= 100)
            {
                pocetSuienok -=100;
                silaKliknutia += 10;
            }
        }

        private void Button_Click(object sender, RoutedEventArgs e)
        {
            if (pocetSuienok >= 5000)
            {
                pocetSuienok -= 5000;
               
            }
        }
    }
}   







<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="Cookie" Content="click" HorizontalAlignment="Center" Height="145" Margin="0,140,0,0" VerticalAlignment="Top" Width="236" Click="Cookie_Click"/>
        <Label x:Name="Label_CookieCounter" Content="Label" HorizontalAlignment="Left" Height="26" Margin="45,51,0,0" VerticalAlignment="Top" Width="88"/>
        <Button x:Name="Button_SilnejsiClick" Content="+1" HorizontalAlignment="Left" Margin="45,124,0,0" VerticalAlignment="Top" Width="50" Click="Button_SilnejsiClick_Click"/>
        <Button x:Name="Button_SuperClick" Content="+10" HorizontalAlignment="Left" Margin="45,180,0,0" VerticalAlignment="Top" Width="50" Click="Button_SuperClick_Click"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="45,232,0,0" VerticalAlignment="Top" Width="50" Click="Button_Click"/>

    </Grid>
</Window>
